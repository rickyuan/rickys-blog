{
  "name": "rickys-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:worker": "wrangler deploy -c workers/digest/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply rickys-blog-db --local -c workers/digest/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply rickys-blog-db --remote -c workers/digest/wrangler.jsonc",
    "astro": "astro",
    "check": "astro check && tsc -p workers/digest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/mdx": "^5.0.0",
    "astro": "^6.0.0",
    "fast-xml-parser": "^5.0.0",
    "marked": "^18.0.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.83.0"
  }
}
