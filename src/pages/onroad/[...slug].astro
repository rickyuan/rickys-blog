---
import { getCollection, getEntry, render } from 'astro:content';
import OnroadLayout from '@layouts/OnroadLayout.astro';
import TripDay from '@components/onroad/TripDay.astro';
import Leg from '@components/onroad/Leg.astro';
import Spot from '@components/onroad/Spot.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('onroad', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const guideEntry = d.guide ? await getEntry('guides', d.guide) : undefined;
const guide =
  guideEntry && !guideEntry.data.draft
    ? {
        href: `/guides/${guideEntry.id}`,
        title: guideEntry.data.title,
        cover: guideEntry.data.cover,
        count: guideEntry.data.species.length,
      }
    : undefined;
---
<OnroadLayout
  title={d.title}
  description={d.description}
  cover={d.cover}
  origin={d.origin}
  destination={d.destination}
  startDate={d.startDate}
  endDate={d.endDate}
  category={d.category}
  status={d.status}
  guide={guide}
>
  <Content components={{ TripDay, Leg, Spot }} />
</OnroadLayout>
