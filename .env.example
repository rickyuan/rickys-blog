# ==========================================
# rickys-blog — Cloudflare-only architecture
# ==========================================
# The site itself needs NO env vars: it reads D1 via the DB binding
# (wrangler.toml locally, Pages project binding in production).
#
# The digest worker (workers/digest) uses Cloudflare secrets, set via:
#   npx wrangler secret put ANTHROPIC_API_KEY -c workers/digest/wrangler.jsonc
# This file only documents them for local `wrangler dev` (.dev.vars).

# Anthropic API key for Haiku (classify) + Sonnet (synthesize / GTM signals)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Token guarding the worker's manual trigger endpoints (/run/weekly, /run/gtm)
RUN_TOKEN=

# Optional — Telegram failure alerts
# Get from @BotFather; chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
