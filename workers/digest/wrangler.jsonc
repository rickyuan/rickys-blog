{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rickys-blog-digest",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Cron schedules disabled 2026-08-18 (Anthropic API credit not topped up).
    // To re-enable: restore ["0 0 * * SUN", "0 23 * * *"] and redeploy.
    // UTC. Sunday 00:00 UTC = Sunday 08:00 SGT (weekly digest);
    // daily 23:00 UTC = 07:00 SGT next day (GTM collection).
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rickys-blog-db",
      "database_id": "0c9a81ef-c949-4ef2-a180-a88f324ac17f",
      "migrations_dir": "../../migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
